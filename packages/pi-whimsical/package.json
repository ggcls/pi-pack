{
  "name": "pi-whimsical",
  "version": "0.1.0",
  "description": "Replace Pi's working message with a random whimsical message.",
  "keywords": [
    "pi-extension",
    "pi-package",
    "whimsical"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ggcls/pi-pack.git",
    "directory": "packages/pi-whimsical"
  },
  "files": [
    "src",
    "pi-whimsical.example.jsonc",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#whimsical/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "pi -e .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pi-pack/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
